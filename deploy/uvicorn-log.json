{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"()": "rabota.ops.logs.JsonFormatter"}
  },
  "handlers": {
    "stderr": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stderr"},
    "counter": {"()": "rabota.ops.logs.CounterHandler"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["stderr", "counter"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stderr", "counter"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false},
    "rabota": {"handlers": ["stderr", "counter"], "level": "INFO", "propagate": false}
  }
}
