# Образец настроек. Реальные значения задаются в .env на сервере, в git он не попадает.

DATABASE_URL=postgresql://user:password@localhost:5432/rabota

# VK: ключ доступа для чтения стен пабликов
VK_ACCESS_TOKEN=

# hh.ru: приложение, зарегистрированное на dev.hh.ru
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_USER_AGENT=

# Языковая модель для неясных постов и картинок
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_TEXT=
LLM_MODEL_VISION=

# Telegram-аккаунт для закрытых чатов (по необходимости)
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=

SITE_URL=https://работа-донецк.рф
