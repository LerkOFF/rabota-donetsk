# Образец настроек. Реальные значения задаются в .env на сервере, в git он не попадает.
# Проверка перед запуском: .venv/bin/python scripts/preflight.py

# ---------- Режим и адрес сайта
# production на боевом сервере; DEBUG на проде всегда выключен
ENVIRONMENT=development
DEBUG=0
SITE_URL=https://работа-донецк.рф
SITE_NAME=
# Журнал: json для journald, пусто или text для чтения глазами
LOG_FORMAT=
# Почта для подвала сайта (контакты)
CONTACT_EMAIL=

# ---------- Данные
# Путь к базе SQLite. Пусто: data/rabota.db рядом с проектом
DB_PATH=
# Срок жизни вакансии в днях и хранение скрытых до удаления
VACANCY_TTL_DAYS=21
EXPIRED_KEEP_DAYS=30

# ---------- За обратным прокси (nginx)
# 1: взять адрес клиента из X-Forwarded-For. Включать только если сайт слушает 127.0.0.1 за nginx, который перезаписывает заголовок
WEB_TRUST_PROXY=0
# Ключ подписи форм (32+ символа, например openssl rand -hex 32). Пусто: создаётся файл data/.secret_key
SECRET_KEY=

# ---------- Почта (подтверждение адреса, сброс пароля)
# MAIL_BACKEND: file (письма в папку data/outbox, только для разработки) или smtp
MAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.ru
# starttls (порт 587), ssl (порт 465) или none
SMTP_SECURITY=starttls

# Открыта ли регистрация (1 или 0). Закройте до заполнения данных оператора и подачи уведомления в Роскомнадзор
REGISTRATION_OPEN=1

# ---------- Данные оператора для юридических текстов (обязательны до открытия регистрации)
OPERATOR_NAME=
OPERATOR_STATUS=
OPERATOR_INN=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=

# ---------- Источники вакансий
# VK: ключ доступа для чтения стен пабликов
VK_ACCESS_TOKEN=

# hh.ru: приложение, зарегистрированное на dev.hh.ru
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_USER_AGENT=

# Языковая модель для неясных постов и картинок (афиши)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_TEXT=
LLM_MODEL_VISION=

# ---------- Telegram в реальном времени: отдельный пользовательский аккаунт, только чтение (Telethon).
# api_id и api_hash выдаёт my.telegram.org. Вход один раз: python -m rabota tg-login
TG_API_ID=
TG_API_HASH=
# Файл сессии вне git, по умолчанию data/telegram (Telethon добавит .session)
TG_SESSION_PATH=
# Прокси для Telegram (слушатель Telethon и сборщик публичных страниц t.me): socks5://host:port или
# socks5://user:pass@host:port. Пусто: напрямую. Если с сервера Telegram недоступен, задайте на сервере.
TELEGRAM_PROXY=
# Дополнительные каналы, по строке на канал (@ не обязателен). По умолчанию data/channels.txt
TG_CHANNELS_FILE=
# Как часто догонять пропущенное, секунд
TG_SWEEP_SECONDS=300

# ---------- Воркер реального времени (python -m rabota worker)
# Папка уменьшенных копий фото из Telegram, по умолчанию data/media
MEDIA_DIR=
# Файл сердцебиения воркера, по умолчанию рядом с базой: data/worker.heartbeat
HEARTBEAT_PATH=
# 0: воркер не запускает ежедневное скрытие старых вакансий (если есть systemd-таймер rabota-expire)
WORKER_EXPIRE=1

# ---------- Наблюдаемость
# Токен для подробностей /healthz/deep (заголовок X-Health-Token). Пусто: подробностей нет
HEALTH_TOKEN=
# Уведомления о сбоях источников в Telegram-бот. Пусто: выключено. Отправка идёт через TELEGRAM_PROXY
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=

# ---------- Резервные копии (scripts/backup.sh)
BACKUP_DIR=/var/backups/rabota
BACKUP_KEEP_DAYS=14
# Необязательно: шифровать копии открытым ключом gpg и/или отправлять на другой сервер (хост:папка)
BACKUP_GPG_RECIPIENT=
BACKUP_RSYNC_TARGET=

# ---------- Яндекс Метрика и Вебмастер (необязательно)
# Номер счётчика. Пусто: ничего не подключается и окна cookie нет. Счётчик загружается только после согласия посетителя
METRIKA_ID=
# 1: запись сессий (вебвизор); на страницах входа и кабинета выключена всегда
METRIKA_WEBVISOR=1
# Файл подтверждения сайта из Вебмастера, например yandex_0123abcd.html (отдаётся по адресу /<имя>)
WEBMASTER_VERIFY_FILE=

# ---------- Админка и жалобы
# Сколько жалоб от разных людей скрывают вакансию автоматически (0: не скрывать). Администратор потом проверяет её вручную
COMPLAINT_AUTOHIDE_THRESHOLD=3
